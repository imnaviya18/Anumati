# Django Core & Secret Settings
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production-anumati-v2-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,web

# PostgreSQL System of Record (Sheet 01 Block 10, Sheet 05)
POSTGRES_DB=anumati
POSTGRES_USER=anumati_app
POSTGRES_PASSWORD=anumati_local_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Separate Audit DB Role (Sheet 01 Block 09, Sheet 07 N5)
POSTGRES_AUDIT_USER=anumati_audit_writer
POSTGRES_AUDIT_PASSWORD=anumati_audit_local_pass

# Redis Broker Only (Sheet 05)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# Private File Storage & Sealed Audit Export Paths (Sheet 01 Block 11, Sheet 07 N5)
PRIVATE_STORAGE_ROOT=/var/lib/anumati/private_storage
SEALED_AUDIT_EXPORT_ROOT=/var/lib/anumati/sealed_audit_exports
MAX_UPLOAD_SIZE_BYTES=26214400

# External Adapters — Disabled by Default (NO EXTERNAL APIs Rule)
EMAIL_DELIVERY_ENABLED=false
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=noreply@anumati.local

ADAPTER_AICTE_ERP_ENABLED=false
ADAPTER_NSWS_INTAKE_ENABLED=false
ADAPTER_SSO_ENABLED=false
ADAPTER_PAYMENT_GATEWAY_ENABLED=false
ADAPTER_SMS_ENABLED=false
ADAPTER_EXTERNAL_SCANNER_ENABLED=false

# Bootstrap Initial Technical Admin (DATA RULES)
BOOTSTRAP_ADMIN_USERNAME=tech_admin
BOOTSTRAP_ADMIN_EMAIL=tech_admin@anumati.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Dashboard Polling Interval (Problem Statement Section B)
VITE_POLLING_INTERVAL_MS=15000
VITE_API_BASE_URL=/api/v1

# Deployment owner approval gates; leave authoritative activation disabled locally.
ALLOW_DEMONSTRATION_POLICIES=true
ALLOW_AUTHORITATIVE_POLICY_ACTIVATION=false
ALLOW_SYNTHETIC_SEED=true
DEMO_PASSWORD=DemoOnly-2026-Local!
FRONTEND_ORIGIN=http://localhost:5173

